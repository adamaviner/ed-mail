{
  "name": "@earthdance/mail",
  "description": "Email for Earthdance's Convex apps: sending through Gmail with retries, a log of every email, saved wording, and the React editor and admin page.",
  "repository": "github:adamaviner/ed-mail",
  "homepage": "https://github.com/adamaviner/ed-mail#readme",
  "version": "0.2.8",
  "license": "Apache-2.0",
  "private": true,
  "keywords": [
    "convex",
    "component"
  ],
  "type": "module",
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc --project ./tsconfig.build.json",
    "build:codegen": "convex codegen --component-dir ./src/component && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc -p example/convex && tsc -p example/src",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "release": "sh scripts/release.sh"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "peerDependencies": {
    "@base-ui/react": "^1.8.0",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/extension-text-align": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "convex": "^1.46.0",
    "lucide-react": "^1.48.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-image": {
      "optional": true
    },
    "@tiptap/extension-text-align": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.3.0",
    "convex": "^1.50.0",
    "convex-test": "^0.0.71",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.73.0",
    "oxlint": "^1.81.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js"
}
